# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
# Local format: postgresql://<user>:<password>@localhost:5432/smartcart_db
# Supabase format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartcart_db

# Tax & Shipping Configuration
FREE_SHIPPING_THRESHOLD=999.00
STANDARD_SHIPPING_FEE=79.00
GST_TAX_PERCENTAGE=5.00
